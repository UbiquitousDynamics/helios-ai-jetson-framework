# Local container overrides
docker-compose.override.yml

# Generated retrieval indexes. The integrity manifest is embedded in the NPZ,
# and the canonical index is rebuilt from uploads/ on first use or via the
# index-building script.
/embeddings.npz
/embeddings.npy
/.embeddings.npz.*.tmp
/*.npz.tmp
/*.npy.tmp
/embeddings-*.npz
/embeddings-*.npy
