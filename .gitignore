# Python bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Local environments and secrets
/venv/
/.venv/
/.env
/.env.*
!/.env.example
/.model/
/model/

# Editor and IDE files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

