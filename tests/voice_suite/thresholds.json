    "hard_failures": [
      "p95 above configured limit",
      "false barge-in above configured limit",
      "any unauthorized egress",
      "any duplicate authoritative dispatch",
      "any leaked worker",
      "any unverified completion claim"
    ],
    "counts": "Counts are nonnegative per-run counts summed for evaluation; rates retain numerator/denominator and cannot average away weighting or failures.",
    "calibration": "Desktop and Jetson require independent calibration against explicit device identities. Calibration evidence hash must accompany every calibrated limit. Production thresholds are never modified by this suite."
