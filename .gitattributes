# Keep source and configuration diffs stable across Windows and Linux.
* text=auto
*.py text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Existing bundled binaries remain ordinary Git objects until a deliberate,
# one-time history migration is approved. New large assets should be staged
# below lfs-assets/ so they use LFS without silently rewriting current files.
/lfs-assets/** filter=lfs diff=lfs merge=lfs -text
