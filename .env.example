# Copy selected values into a deployment-owned environment file or secret
# manager. Never put API-key values in this repository.
HELIOS_LANGUAGE=it
HELIOS_OLLAMA_HOST=http://127.0.0.1:11434

# DEBUG, INFO, WARNING, ERROR, or CRITICAL. Use "-" to send logs to stderr
# instead of the default append-only app.log file.
HELIOS_LOG_LEVEL=INFO
HELIOS_LOG_FILE=app.log
# HELIOS_PYTHON=/absolute/path/to/venv/bin/python3

# Offline-safe default. Point this at another example only after completing
# docs/HYBRID_LLM_OPERATIONS.md.
HELIOS_LLM_CONFIG=examples/llm-routing.offline.toml
HELIOS_LLM_REMOTE_ENABLED=false
HELIOS_LLM_EMERGENCY_LOCAL_ONLY=false

# Optional content-free KPI storage and local dashboard. Both remain disabled
# unless explicitly enabled. Prefer SSH port forwarding over a LAN bind.
HELIOS_KPI_ENABLED=false
HELIOS_KPI_STORAGE_PATH=logs/helios-kpi.sqlite3
HELIOS_KPI_QUEUE_SIZE=2048
HELIOS_KPI_BATCH_SIZE=64
HELIOS_KPI_FLUSH_INTERVAL_SECONDS=0.5
HELIOS_KPI_RAW_RETENTION_DAYS=14
HELIOS_KPI_ROLLUP_RETENTION_DAYS=90
HELIOS_KPI_MAX_DATABASE_MB=256
HELIOS_KPI_ROLLUP_INTERVAL_SECONDS=300
HELIOS_KPI_RESOURCE_INTERVAL_SECONDS=5
HELIOS_KPI_DASHBOARD_ENABLED=false
HELIOS_KPI_DASHBOARD_HOST=127.0.0.1
HELIOS_KPI_DASHBOARD_PORT=8765
HELIOS_KPI_DASHBOARD_ALLOW_LAN=false
HELIOS_KPI_EXPORT_ENABLED=true
# For an explicitly authorized LAN bind, set this to the NAME of an external
# environment variable containing the Bearer token / browser Basic password.
# Never put the secret here.
# HELIOS_KPI_DASHBOARD_AUTH_TOKEN_ENV=HELIOS_KPI_DASHBOARD_TOKEN

# Names shown here match api_key_env in the example routing files. Values must
# be injected outside source control.
# GROQ_API_KEY=
# OPENAI_API_KEY=
