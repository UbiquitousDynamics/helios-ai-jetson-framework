# Copy selected values into a deployment-owned environment file or secret
# manager. Never put API-key values in this repository.
HELIOS_LANGUAGE=it
HELIOS_OLLAMA_HOST=http://127.0.0.1:11434

# Offline-safe default. Point this at another example only after completing
# docs/HYBRID_LLM_OPERATIONS.md.
HELIOS_LLM_CONFIG=examples/llm-routing.offline.toml
HELIOS_LLM_REMOTE_ENABLED=false
HELIOS_LLM_EMERGENCY_LOCAL_ONLY=false

# Names shown here match api_key_env in the example routing files. Values must
# be injected outside source control.
# GROQ_API_KEY=
# OPENAI_API_KEY=
